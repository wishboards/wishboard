# Network & Domain Configuration
VITE_WISHBOARD_DOMAIN=wishboard.painless-computing.com
VITE_WISHBOARD_AP_IP=10.42.0.1
# WISHBOARD_DOMAIN=wishboard.painless-computing.com
# WISHBOARD_AP_IP=10.42.0.1:3000
# CORS_ALLOWED_ORIGINS=https://wishboard.painless-computing.com

# Admin Account Credentials (Created on initial boot if absent)
# WISHBOARD_ADMIN_USERNAME=admin
# WISHBOARD_ADMIN_SECRET=SuperSecretPassword123

# Optional AI Features & Semantic Search
# Set ENABLE_AI_FEATURES=true to activate background tagging and semantic search
ENABLE_AI_FEATURES=false

# Provider type: "noop" ($0/mo, disabled), "local" ($0/mo, offline Pi 4 CPU), or "cloud" (Google Gemini / OpenAI)
AI_PROVIDER=noop

# Cloud Provider Settings (Only needed when AI_PROVIDER=cloud)
# AI_API_KEY=your-gemini-or-openai-api-key
# AI_MODEL=gemini-2.0-flash
# AI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
